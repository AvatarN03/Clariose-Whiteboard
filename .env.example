# Existing application configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# AI configuration — server-only; do not prefix these with NEXT_PUBLIC_.
# Recommended MVP provider: direct Gemini Developer API. OpenRouter is an
# optional fallback/router for experiments with free models.
# The provider adapter will be added in Phase 3; these variables are documented
# now so the deployment contract is explicit.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_PROVIDER=openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_PROMPT_CHARS=4000
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_NODES=80
AI_MAX_EDGES=120
AI_MONTHLY_BUDGET_USD=
