# Existing application configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# AI configuration. Only the selected provider key is required.
# These values are server-only; never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Optional fallback and safety limits. Defaults will be used when omitted.
# AI_FALLBACK_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_PROMPT_CHARS=4000
